{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRADE",
  "version": "1.1.2",
  "identifier": "com.dosgcnn.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GRADE - Graph-based Representation for Atomic DOS Estimation",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python-model/dist/dos-gcnn-sidecar": "sidecar"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
